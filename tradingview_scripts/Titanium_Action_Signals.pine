//@version=5
indicator("Titanium Action Signals", overlay=true)

// --- Parameters ---
flash_lookback = input.int(3, title="Flash Lookback", tooltip="Ani hareket arama penceresi")
flash_threshold = input.float(3.0, title="Flash Threshold (%)", tooltip="Yüzdelik değişim eşiği")
wick_ratio = input.float(2.0, title="Wick/Body Ratio", tooltip="Fitilin gövdeye minimum oranı")
vol_lookback = input.int(20, title="Volume Lookback", tooltip="Hacim ortalaması periyodu")
vol_mult = input.float(3.0, title="Volume Spike Multiplier", tooltip="Ortalama hacmin kaç katı")

// --- 1. Flash Move (Ani Hareket) ---
start_price = close[flash_lookback]
change_pct = ((close - start_price) / start_price) * 100
is_bullish = close > open

flash_up = (change_pct <= -flash_threshold) and is_bullish
flash_down = (change_pct >= flash_threshold) and not is_bullish

// --- 2. Wick Rejection (Fitil Reddi) ---
body = math.max(math.abs(close - open), 0.0001)
top = math.max(close, open)
bot = math.min(close, open)
upper_wick = high - top
lower_wick = bot - low

u_ratio = upper_wick / body
l_ratio = lower_wick / body

wick_up = (l_ratio >= wick_ratio) and (l_ratio > u_ratio)
wick_down = (u_ratio >= wick_ratio) and (u_ratio > l_ratio)

// --- 3. Volume Spike (Hacim Patlaması) ---
vol_sma = ta.sma(volume, vol_lookback)
ratio = vol_sma > 0 ? volume / vol_sma : 1.0

vol_spike_up = (ratio >= vol_mult) and is_bullish
vol_spike_down = (ratio >= vol_mult) and not is_bullish

// --- Plotting ---
plotshape(flash_up, title="Flash Up", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="FLASH")
plotshape(flash_down, title="Flash Down", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="FLASH")

plotshape(wick_up, title="Wick Rej Up", style=shape.labelup, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny, text="WICK")
plotshape(wick_down, title="Wick Rej Down", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="WICK")

plotshape(vol_spike_up, title="Vol Spike Up", style=shape.circle, location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny)
plotshape(vol_spike_down, title="Vol Spike Down", style=shape.circle, location=location.abovebar, color=color.new(color.purple, 0), size=size.tiny)
