//@version=5
indicator("Titanium Volatility Squeeze", overlay=false)

// --- Parameters ---
bb_period = input.int(20, "BB Period")
vol_lookback = input.int(20, "Volume Lookback")
atr_period = input.int(14, "ATR Period")

// --- 1. Bollinger Band Tightness (Daralma) ---
sma = ta.sma(close, bb_period)
std = ta.stdev(close, bb_period)
bb_width = sma > 0 ? ((std * 2) / sma * 100) : 0

// Tarihsel yüzde hesabı (son 50 bar)
is_tight = false
count_lower = 0
for i = 1 to 50
    if nz(bb_width[i], 0) < bb_width
        count_lower += 1
bb_pct = (count_lower / 50.0) * 100
is_tight := bb_pct < 20 // En dar %20'lik dilimde mi?

// --- 2. Volume Expanding (Hacim Artışı) ---
vol_sma = ta.sma(volume, vol_lookback)
vol_recent = math.sum(volume, 3) / 3
vol_expanding = vol_sma > 0 ? (vol_recent / vol_sma > 1.5) : false

// --- 3. ATR Normalizasyonu ---
atr_val = ta.atr(atr_period)
atr_sma50 = ta.sma(atr_val, 50)
atr_std50 = ta.stdev(atr_val, 50)
atr_z = atr_std50 > 0 ? (atr_val - atr_sma50) / atr_std50 : 0
atr_normal = atr_z < 1.5 // ATR çok yüksek değilse

// --- 4. Squeeze Condition ---
is_squeeze = is_tight and vol_expanding and atr_normal

// --- Plotting ---
bgcolor(is_squeeze ? color.new(color.yellow, 70) : na, title="Squeeze Alert Background")
plot(bb_width, color=color.aqua, title="BB Width %", linewidth=2)
hline(20, "Tightness Reference (Visual)", color=color.gray, linestyle=hline.style_dotted)

plotchar(is_squeeze, title="Squeeze Data", char="", location=location.bottom, size=size.tiny)
